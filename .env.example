PORT=3001
# Server-side origin for the Fake Store-compatible product provider.
PRODUCT_API_ORIGIN=https://fakestoreapi.com
SALES_EMAIL=sales@example.test
SMTP_FROM=catalogue@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Enable a local capture adapter during development without SMTP.
ENQUIRY_MODE=smtp
