{
  "name": "ai-product-catalogue",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "express": "^5.1.0",
    "nodemailer": "^10.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
